# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# ── OpenAI — NO LONGER NEEDED ────────────────────────────────────────────────
# The weekly refresh now uses Wikipedia's free API + rule-based classification.
# No AI API key required. Total weekly cost: $0.

# ── Refresh endpoint protection ───────────────────────────────────────────────
# Random secret — set the same value in GitHub Actions secrets
REFRESH_SECRET=change-me-to-a-random-string
